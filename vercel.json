{
  "version": 2,
  "buildCommand": "echo 'Using Vercel Python runtime'",
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/main.py"
    }
  ],
  "functions": {
    "backend/main.py": {
      "runtime": "python3.12"
    }
  }
}
